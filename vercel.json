    },
    {
      "path": "/api/actualizar-venta-30d",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/actualizar-pnl-gastos",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/actualizar-pnl-gastos?mesAtras=1",
      "schedule": "5 7 * * *"
    },
    {
      "path": "/api/actualizar-pnl-gastos?mesAtras=2",
      "schedule": "40 7 * * *"
    },
    {
      "path": "/api/actualizar-pnl-venta-vivo",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/actualizar-customer-grupos",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/actualizar-supplier-items",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/anio-pasado-liviano",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/actualizar-google-resenas",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/nubi-actualizar",
      "schedule": "*/5 11-12 * * *"
    },
    {
      "path": "/api/nubi-actualizar",
      "schedule": "*/15 15-16 * * *"
    },
    {
      "path": "/api/nubi-vigilancia",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/facturas-sincronizar",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/facturas-sincronizar?modo=reconciliar",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/ov-sincronizar",
      "schedule": "7-59/15 * * * *"
    },
    {
      "path": "/api/ov-sincronizar?modo=reconciliar",
      "schedule": "25 6 * * *"
    }
